{
  "name": "filepress",
  "version": "0.1.0",
  "description": "Self-hosted PDF tools. Files are processed on your own server and wiped after an hour.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check public/app.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "multer": "^2.0.1",
    "p-queue": "^8.1.0",
    "pdf-lib": "^1.17.1"
  },
  "license": "MIT"
}
