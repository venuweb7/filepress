# Copy to .env for local runs (the server reads real environment variables; Railway sets them in the dashboard).
PORT=8080
APP_NAME=Pressa
# Shared passcode for the whole site. Leave empty to let anyone with the link use it.
ACCESS_CODE=
# Long random string; keeps people signed in across restarts. Empty = new random secret at every boot.
SESSION_SECRET=
MAX_FILE_MB=200
MAX_FILES=20
RETENTION_MIN=60
CONCURRENCY=2
TOOL_TIMEOUT_SEC=240
HEAVY_TIMEOUT_SEC=480
# Where job folders live (ephemeral is fine)
JOBS_DIR=/tmp/pressa-jobs
